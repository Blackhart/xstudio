{
    "plugin": {
        "data_source": {
            "mikros_shotbrowser": {
                "browser_mode": {
                    "context": [
                        "PLUGIN"
                    ],
                    "datatype": "string",
                    "default_value": "shot",
                    "description": "Shot, asset, or shelf list shown in the Mikros Shot Browser.",
                    "path": "/plugin/data_source/mikros_shotbrowser/browser_mode",
                    "value": "shot"
                },
                "result_view": {
                    "context": [
                        "PLUGIN"
                    ],
                    "datatype": "string",
                    "default_value": "versions",
                    "description": "Versions or playlist list shown in the Mikros Shot Browser.",
                    "path": "/plugin/data_source/mikros_shotbrowser/result_view",
                    "value": "versions"
                },
                "left_pane_width": {
                    "context": [
                        "PLUGIN"
                    ],
                    "datatype": "double",
                    "default_value": 0.0,
                    "description": "Left column width in pixels. Zero keeps the default ratio.",
                    "path": "/plugin/data_source/mikros_shotbrowser/left_pane_width",
                    "value": 0.0
                },
                "shelves": {
                    "context": [
                        "PLUGIN"
                    ],
                    "datatype": "json",
                    "default_value": [],
                    "description": "User shelves: named FieldExpr filters for versions or playlists.",
                    "path": "/plugin/data_source/mikros_shotbrowser/shelves",
                    "value": []
                },
                "shelf_edit_popup_width": {
                    "context": [
                        "PLUGIN"
                    ],
                    "datatype": "double",
                    "default_value": 520.0,
                    "description": "Width in pixels of the shelf editor popup.",
                    "path": "/plugin/data_source/mikros_shotbrowser/shelf_edit_popup_width",
                    "value": 520.0
                },
                "shelf_edit_popup_height": {
                    "context": [
                        "PLUGIN"
                    ],
                    "datatype": "double",
                    "default_value": 440.0,
                    "description": "Height in pixels of the shelf editor popup.",
                    "path": "/plugin/data_source/mikros_shotbrowser/shelf_edit_popup_height",
                    "value": 440.0
                }
            }
        }
    }
}
